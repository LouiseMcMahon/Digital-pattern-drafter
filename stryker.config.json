{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "coverageAnalysis": "off",
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "timeoutMS": 6000,
  "ignoreStatic": false,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "tempDirName": ".stryker-tmp",
  "tsconfigFile": "tsconfig.stryker-unused.json",
  "disableTypeChecks": false,
  "commandRunner": {
    "command": "node node_modules/vitest/vitest.mjs run --config vitest.mutation.config.ts --reporter=dot --bail=1"
  },
  "timeoutFactor": 0.25
}
{
  "name": "digital-pattern-drafter",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --exclude src/core/fit.test.ts --exclude src/core/golden.test.ts",
    "coverage": "vitest run --coverage",
    "mutate": "node scripts/mutate.mjs",
    "fixtures:regenerate": "REGEN_FIXTURES=1 vitest run src/core/fixtures.generate.test.ts --testTimeout=900000",
    "golden:update": "UPDATE_GOLDEN=1 vitest run src/core/golden.test.ts --testTimeout=600000",
    "golden:refit": "UPDATE_GOLDEN=refit vitest run src/core/golden.test.ts --testTimeout=600000",
    "e2e": "node scripts/e2e-smoke.mjs",
    "check": "npm run mutate:changed && npm run typecheck && npm run coverage && npm run build",
    "mutate:gate": "node scripts/mutate.mjs all --gate",
    "mutate:changed": "node scripts/mutate.mjs changed --gate",
    "check:fast": "npm run typecheck && npm run coverage && npm run build"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.5",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
